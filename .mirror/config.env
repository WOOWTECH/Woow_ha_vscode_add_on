# Mirror config — sourced by workflows. Each mirror repo has its own copy
# with different UPSTREAM_URL / UPSTREAM_BRANCH / KEEP_SUBDIRS.
# MIRROR_IMAGE_PREFIX stays uniform across all mirrors.

UPSTREAM_URL=https://github.com/hassio-addons/repository
UPSTREAM_BRANCH=master
MIRROR_IMAGE_PREFIX=ghcr.io/woowtech/ha-mirror-
# Top-level paths kept on `main`. The `upstream` branch is never pruned.
KEEP_SUBDIRS="vscode LICENSE.md"
